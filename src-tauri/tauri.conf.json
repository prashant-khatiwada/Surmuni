{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Surmuni",
  "version": "1.0.0",
  "identifier": "com.surmuni.audio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Surmuni Audio Player",
        "width": 275,
        "height": 232,
        "minWidth": 275,
        "minHeight": 14,
        "decorations": false,
        "transparent": true,
        "resizable": true
      },
      {
        "label": "preferences",
        "title": "Surmuni Preferences",
        "url": "preferences.html",
        "width": 560,
        "height": 440,
        "minWidth": 500,
        "minHeight": 380,
        "decorations": true,
        "resizable": true,
        "visible": false
      },
      {
        "label": "visualizer",
        "title": "MilkDrop 2 Visualizer — Surmuni",
        "url": "visualizer.html",
        "width": 640,
        "height": 480,
        "minWidth": 400,
        "minHeight": 300,
        "decorations": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
